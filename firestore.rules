rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن الأساسيون: ثابتون هنا ولا يمكن حذفهم من صفحة الأدمن
    function isOwner() {
      return request.auth.token.email in ["logistipost@gmail.com", "mohammadmarei44@gmail.com"];
    }

    // الأدمن: مسجّل دخول بإيميل موثّق (تسجيل الدخول بـ Google يوثّقه تلقائياً)،
    // وإيميله من الأساسيين أو مضاف في مجموعة admins
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isOwner() || exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // فحص بسيط لشكل بيانات المتجر قبل الحفظ
    function validStore() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!('fields' in d) || (d.fields is list && d.fields.size() <= 40))
        && (!('notes' in d) || (d.notes is list && d.notes.size() <= 20));
    }

    // فحص بسيط لشكل بيانات الإعلان قبل الحفظ
    function validAd() {
      let d = request.resource.data;
      return (!('title' in d) || (d.title is string && d.title.size() <= 120))
        && (!('title_en' in d) || (d.title_en is string && d.title_en.size() <= 120))
        && (!('text' in d) || (d.text is string && d.text.size() <= 600))
        && (!('text_en' in d) || (d.text_en is string && d.text_en.size() <= 600))
        && (!('active' in d) || d.active is bool);
    }

    // المشرفون الإضافيون: رقم المستند = الإيميل. الأدمن فقط يقرأ ويضيف ويحذف
    match /admins/{email} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && email == email.lower()
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // المتاجر (عناوين الشحن): قراءة للجميع، والتعديل للأدمن فقط
    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isAdmin() && validStore();
      allow delete: if isAdmin();
    }

    // الإعلانات والعروض في الصفحة الرئيسية: قراءة للجميع، والتعديل للأدمن فقط
    match /ads/{adId} {
      allow read: if true;
      allow create, update: if isAdmin() && validAd();
      allow delete: if isAdmin();
    }

    // الطلبات: مسموح جلب طلب واحد برقم التتبع فقط
    // ممنوع عرض قائمة الطلبات، وممنوع الكتابة من الموقع
    match /orders/{orderId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // أي مجموعة أخرى: ممنوعة بالكامل
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
